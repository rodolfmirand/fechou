# Copie para .env e preencha. Nunca versione o .env real.
# Linhas vazias (ex.: SMTP_USER=) contam como "não definido".

# Google (modo google_sheets)
GOOGLE_APPLICATION_CREDENTIALS=./secrets/service-account.json

# SMTP (genérico: funciona com qualquer provedor, ex.: Gmail com senha de app)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
# starttls (porta 587) | ssl (porta 465) | none (só para servidor de teste local)
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Fechou <relatorios@exemplo.com>"
# Tempo máximo de cada tentativa de conexão, em segundos
SMTP_TIMEOUT=30

# Telegram (opcional; ainda não implementado)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Geral
LOG_LEVEL=INFO
DATABASE_PATH=./data/fechou.db
# Pasta onde os PDFs gerados são salvos
OUTPUT_DIR=./out
